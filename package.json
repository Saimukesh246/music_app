{
  "name": "aura",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test:shared": "npm --prefix packages/shared test",
    "test:mobile": "npm --prefix apps/mobile test -- --watchAll=false",
    "test:api": "pytest apps/api",
    "test:all": "npm run test:shared && npm run test:mobile && npm run test:api",
    "test": "npm run test:shared && npm run test:mobile",
    "start:mobile": "npm --prefix apps/mobile start",
    "android": "npm --prefix apps/mobile run android",
    "android:build": "cd apps/mobile/android && .\\gradlew.bat assembleRelease",
    "android:build:debug": "cd apps/mobile/android && .\\gradlew.bat assembleDebug"
  }
}
